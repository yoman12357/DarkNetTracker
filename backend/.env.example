NODE_ENV=development
HOST=0.0.0.0
PORT=4000
TRUST_PROXY=false

APP_DEFAULT_USER=admin
APP_DEFAULT_PASS=change-me-now
APP_ANALYST_USER=analyst
APP_ANALYST_PASS=change-me-too
APP_VIEWER_USER=viewer
APP_VIEWER_PASS=change-me-viewer

AUTH_TOKEN_TTL_HOURS=8
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
UPLOAD_LIMIT_BYTES=104857600
PYTHON_EXECUTABLE=python
PYTHON_TIMEOUT_MS=300000
PYTHON_MAX_RETRIES=2

ALLOWED_ORIGINS=http://localhost:3000
CSRF_SECRET=replace-with-a-long-random-secret

TLS_ENABLED=false
TLS_KEY_PATH=
TLS_CERT_PATH=
